# 复制为 .env 后按本机环境修改。密钥类字段勿提交仓库。

# Application
APP_NAME=weitai-agent
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
# CORS：开发可用 *；生产改为前端域名白名单，逗号分隔
CORS_ORIGINS=*

# Server
API_HOST=0.0.0.0
API_PORT=8100

# MySQL（与 infra/docker-compose.yml 默认账号对齐；宿主机 13306，避开 zhongji 的 3306）
DATABASE_URL=mysql+asyncmy://weitai:weitai_dev@127.0.0.1:13306/weitai_agent?charset=utf8mb4

# Redis（Compose 默认映射宿主机 26379 → 容器 6379，避开 zhongji 的 16379）
REDIS_URL=redis://127.0.0.1:26379/0

# Chat 热会话 / Stream 归档
# Redis List 存活跃会话消息，TTL 到期前由 Worker 补写 MySQL
CHAT_SESSION_TTL_SECONDS=604800
CHAT_COLD_START_TURNS=15
CHAT_STREAM_KEY=agent:chat:stream
CHAT_STREAM_DLQ_KEY=agent:chat:stream:dql
CHAT_STREAM_GROUP=chat-archiver
CHAT_STREAM_BATCH_SIZE=30
CHAT_STREAM_BLOCK_MS=5000

# 超长对话裁剪 / 限流 / 会话锁
CHAT_TRIM_TRIGGER_TURNS=25
CHAT_TRIM_KEEP_TURNS=10
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_SESSION_LOCK_TTL_SECONDS=300
CHAT_TTL_SCAN_THRESHOLD_SECONDS=3600
CHAT_TTL_SCAN_CRON=0 3 * * *

# 操作日志 / 登录日志保留天数（超时滚动删除）
AUDIT_LOG_RETENTION_DAYS=7

# JWT（生产务必换成足够长的随机串）
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 本地文件存储根（知识库上传等）
STORAGE_ROOT=./storage

# MCP stdio 仓库根（可选；不设则自动探测 scripts/mcp_utility_server.py）
# WEITAI_ROOT=E:\code\python\weitaiAgent

# Qdrant（知识库向量；宿主机 16333，避开 zhongji 的 6333）
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
QDRANT_COLLECTION=weitai_knowledge

# 知识库切块 / 检索
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_SEARCH_TOP_K=5
KB_SEARCH_MIN_SCORE=0.0
KB_SEARCH_CANDIDATE_MULTIPLIER=4
KB_SEARCH_KEYWORD_WEIGHT=0.4

# Embedding 批大小与 Redis 向量缓存 TTL
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHARS=6000
CHAT_EMBED_CACHE_TTL_SECONDS=604800
