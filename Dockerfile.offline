# Offline delivery image. Build on Linux with Docker BuildKit.
FROM python:3.12-slim AS build

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/src/apps:/src/packages
WORKDIR /src

RUN pip install --no-cache-dir poetry==2.1.3 nuitka==2.7.12
COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.create false \
    && poetry install --only main --no-interaction --no-ansi
COPY apps ./apps
COPY packages ./packages
COPY workers ./workers
COPY alembic.ini ./

# Keep the runtime payload free of project .py files. Dynamic imports used by
# this project are included explicitly and must be covered by the smoke test.
RUN python -m nuitka --standalone --follow-imports \
    --include-package=api --include-package=common --include-package=db \
    --include-package=workers --output-dir=/out/api apps/api/main.py \
    && python -m nuitka --standalone --follow-imports \
    --include-package=common --include-package=db --include-package=workers \
    --output-dir=/out/worker workers/stream_consumer_main.py

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=build /out/api/main.dist /app/api
COPY --from=build /out/worker/stream_consumer_main.dist /app/worker
COPY --from=build /src/packages/db/alembic /app/alembic
COPY alembic.ini /app/alembic.ini
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/storage /app/logs \
    && chown -R appuser:appuser /app
USER appuser
EXPOSE 8100
ENTRYPOINT ["/app/api/main.bin"]
