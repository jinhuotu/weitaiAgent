# 复制为 .env 后按本机环境修改。密钥类字段勿提交仓库。

# Application
APP_NAME=weitai-agent
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
# CORS：开发可用 *；生产改为前端域名白名单，逗号分隔
CORS_ORIGINS=*

# Server
API_HOST=0.0.0.0
API_PORT=8100

# MySQL（与 infra/docker-compose.yml 默认账号对齐；宿主机 13306，避开 zhongji 的 3306）
DATABASE_URL=mysql+asyncmy://weitai:weitai_dev@127.0.0.1:13306/weitai_agent?charset=utf8mb4

# Redis（Compose 默认映射宿主机 26379 → 容器 6379，避开 zhongji 的 16379）
REDIS_URL=redis://127.0.0.1:26379/0

# Chat 热会话 / Stream 归档
# Redis List 存活跃会话消息，TTL 到期前由 Worker 补写 MySQL
CHAT_SESSION_TTL_SECONDS=604800
CHAT_COLD_START_TURNS=15
CHAT_STREAM_KEY=agent:chat:stream
CHAT_STREAM_DLQ_KEY=agent:chat:stream:dql
CHAT_STREAM_GROUP=chat-archiver
CHAT_STREAM_BATCH_SIZE=30
CHAT_STREAM_BLOCK_MS=5000

# 超长对话裁剪 / 限流 / 会话锁
CHAT_TRIM_TRIGGER_TURNS=25
CHAT_TRIM_KEEP_TURNS=10
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_SESSION_LOCK_TTL_SECONDS=300
CHAT_TTL_SCAN_THRESHOLD_SECONDS=3600
CHAT_TTL_SCAN_CRON=0 3 * * *

# 操作日志 / 登录日志保留天数（超时滚动删除）
AUDIT_LOG_RETENTION_DAYS=7

# JWT（生产务必换成足够长的随机串）
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 本地文件存储根（知识库上传等）
STORAGE_ROOT=./storage
KB_UPLOAD_MAX_BYTES=209715200
KB_EXTRACT_MAX_CHARS=2000000

# 知识库 OCR（阿里云「文字识别」ocr-api，不是文档智能 DocMind）
# 测试：OCR_PROVIDER=aliyun 并填 RAM 子账号 AK；局域网可 OCR_PROVIDER=rapidocr
# 密钥只放本机 .env，不要提交仓库、不要贴到聊天
OCR_PROVIDER=none
OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
OCR_ACCESS_KEY_ID=
OCR_ACCESS_KEY_SECRET=
OCR_TYPE=Advanced
OCR_TIMEOUT_SECONDS=60
OCR_MAX_PAGES=200
OCR_PAGE_TEXT_MIN_CHARS=50
# 后台解析超过该秒数仍为 parsing 时，启动会标失败（可点重试）
KB_PARSE_TIMEOUT_SECONDS=3600

# MCP stdio 仓库根（可选；不设则自动探测 scripts/mcp_utility_server.py）
# WEITAI_ROOT=E:\code\python\weitaiAgent

# Qdrant（知识库向量；宿主机 16333，避开 zhongji 的 6333）
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
QDRANT_COLLECTION=weitai_knowledge
# none / int8 / binary（仅新建集合；已有集合请到系统设置应用）
QDRANT_QUANTIZATION=none

# 知识库切块 / 检索
KB_CHUNK_SIZE=600
KB_CHUNK_OVERLAP=150
KB_SEARCH_TOP_K=5
KB_SEARCH_MIN_SCORE=0.0
KB_SEARCH_CANDIDATE_MULTIPLIER=4
KB_SEARCH_KEYWORD_WEIGHT=0.4

# Embedding 批大小与 Redis 向量缓存 TTL
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHARS=6000
CHAT_EMBED_CACHE_TTL_SECONDS=604800

# OnlyOffice 在线 Word（投标文件浏览器内编辑）
# 先启动：cd infra && docker compose up -d onlyoffice
# Windows 建议先运行 infra/sync-onlyoffice-fonts.ps1，把宋体拷进 onlyoffice-fonts，否则预览分页会比本地 Word 多。
ONLYOFFICE_DOCUMENT_SERVER_URL=http://127.0.0.1:8082
ONLYOFFICE_JWT_SECRET=onlyoffice-dev-secret-change-me
# OnlyOffice 容器访问 API 的根 URL（Windows/Mac Docker 默认 host.docker.internal）
ONLYOFFICE_PUBLIC_API_BASE=http://host.docker.internal:8100
ONLYOFFICE_DOWNLOAD_TOKEN_TTL_SECONDS=3600
